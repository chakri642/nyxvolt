# --- Secrets & credentials ---
.env
.env.local
.env.*.local
youtube_cookies.txt
.instagram_session.json
*.session

# --- Runtime state ---
# Tracked in git so state persists across ephemeral Colab sessions:
#   .used_clips_movies.json      — video-ID dedup (prevents reposting)
#   .movie_candidates_cache.json — YouTube search cache (24h TTL, saves API quota)
# Other .used_clips_*.json (legacy sources) stay ignored.
.used_clips.json
.used_clips_main.json
.used_clips_brainrot.json

# --- Generated media (large, transient) ---
clips/raw/
clips/processed/
clips/output/
clips/secondary/
clips/*.mp4
clips/*.mov
clips/*.webm

# --- Music library (large binary files) ---
music/**/*.mp3
music/**/*.wav
music/**/*.m4a
music/**/*.aac

# --- Logs ---
logs/
*.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- macOS ---
.DS_Store
.AppleDouble
